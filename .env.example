# ─────────────────────────────────────────────────────────────────────────────
# VowLMS — Environment Variables
# Copy this file to .env.local for development, then set each value.
# All production values must be added to Vercel → Project → Settings → Env Vars
# ─────────────────────────────────────────────────────────────────────────────

# ── Bridge (Afrihost PHP API) ─────────────────────────────────────────────────
# Full public URL of the PHP API on Afrihost (no trailing slash)
# This is the URL Vercel uses to reach the PHP bridge
# Example: https://api.goalvow.com
BRIDGE_BASE_URL=https://api.goalvow.com

# Shared secret between Next.js and PHP — PHP rejects requests without this header
# Generate with: openssl rand -hex 32
BRIDGE_API_KEY=

# ── App URL ───────────────────────────────────────────────────────────────────
# Full public URL of the Next.js app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://vowlms.vercel.app

# Shared only with VowHumans Studio. Signs five-minute lesson-context tokens so
# the presenter can read approved lesson resources without learner uploads.
# Generate with: openssl rand -hex 32
VOWHUMANS_LESSON_CONTEXT_SECRET=

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Same secret used by PHP to sign JWTs — must match JWT_SECRET in PHP config
# Generate with: openssl rand -base64 32
JWT_SECRET=

# ── PayFast Payments ──────────────────────────────────────────────────────────
# Get these from https://www.payfast.co.za/registration/merchant
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=replace_with_payfast_passphrase
# Set to "false" for live, "true" for sandbox
PAYFAST_SANDBOX=true

# ── GoalVow Ecosystem Integrations ───────────────────────────────────────────
VOWREWARDS_API_URL=https://vowrewards.goalvow.com/api
VOWREWARDS_API_KEY=

PLUGCONNECT_API_URL=https://plugconnect.goalvow.com/api
PLUGCONNECT_API_KEY=

VOWSUPPORT_API_URL=https://vowsupport.goalvow.com/api
VOWSUPPORT_API_KEY=

SKILLSSHOP_API_URL=https://skillsshop.goalvow.com/api
SKILLSSHOP_API_KEY=

VOWTOOLS_API_URL=https://vowtools.goalvow.com/api
VOWTOOLS_API_KEY=

CHEFORDER_API_URL=https://cheforder.goalvow.com/api
CHEFORDER_API_KEY=

# ── Email (SMTP via Afrihost) ─────────────────────────────────────────────────
SMTP_HOST=mail.goalvow.com
SMTP_PORT=587
SMTP_USER=support@goalvow.com
SMTP_PASS=replace_with_email_password
SMTP_FROM="GoalVow LMS <noreply@goalvow.com>"

# ── QA diagnostics (public/php/api/qa/*) ───────────────────────────────────────
# Opt-in switch for test-payfast-itn-simulator.php — leave unset in production.
# Only set to "true" in a non-production environment when you need to exercise
# the PayFast ITN handler with a synthetic callback.
ALLOW_QA_SIMULATORS=

# Recipient for run-all-diagnostics.php's optional SMTP check (?includeWriteTests=true).
# Defaults to support@goalvow.com if unset.
QA_DIAGNOSTIC_EMAIL=

# ── Moodle Source Tokens (migration only — not needed in production) ──────────
UPSKILLING_MOODLE_BASE_URL=https://goalvow.com/upskilling
UPSKILLING_MOODLE_TOKEN=
SKILLS_TRAINING_MOODLE_BASE_URL=https://goalvow.com/skills-training
SKILLS_TRAINING_MOODLE_TOKEN=
CHEF_ACADEMY_MOODLE_BASE_URL=https://goalvow.com/chef-academy
CHEF_ACADEMY_MOODLE_TOKEN=
GOALVOW_SCHOOLS_MOODLE_BASE_URL=https://goalvow.com/schools
GOALVOW_SCHOOLS_MOODLE_TOKEN=
BUSINESS_SCHOOL_MOODLE_BASE_URL=https://goalvow.com/business-school
BUSINESS_SCHOOL_MOODLE_TOKEN=
GOALVOW_UNIVERSITY_MOODLE_BASE_URL=https://goalvow.com/university
GOALVOW_UNIVERSITY_MOODLE_TOKEN=
RESOURCE_SIGNING_SECRET=replace_with_a_different_long_random_secret
